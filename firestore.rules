rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function protectedUserFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.companyCode == resource.data.companyCode
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.billing == resource.data.billing
        && request.resource.data.usage == resource.data.usage;
    }

    match /users/{userId} {
      allow create, delete: if false;
      allow read: if isSelf(userId);
      allow update: if isSelf(userId) && protectedUserFieldsUnchanged();

      match /reports/{reportId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /dailyUsage/{dateKey} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    match /companies/{companyCode} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
